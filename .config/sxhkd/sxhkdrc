# --- System Controls ---

# Brightness
XF86MonBrightnessUp
    brightnessctl set 10%+

XF86MonBrightnessDown
    brightnessctl set 10%-

# Audio (PipeWire / WirePlumber matching Openbox & DWM)
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- 	

XF86AudioRaiseVolume
    wpctl set-volume -l 2.0 @DEFAULT_AUDIO_SINK@ 5%+

# Media Controls
XF86AudioPlay
    playerctl play-pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous

# --- Program Launchers ---

# Terminal emulator (Super + Return)
super + Return
    alacritty

# Rofi launchers
super + w
    rofi -show drun

super + r
    rofi -show run

# Quick Apps
super + e
    pcmanfm

# Screenshot
Print
    flameshot full -p ~/Pictures/Screenshots/

# Dunst  
ctrl + grave
    dunstctl history-pop

# Reload sxhkd
super + Escape
    pkill -USR1 -x sxhkd

# --- bspwm Hotkeys ---

# Quit/Restart bspwm 
ctrl + alt + {q,r}
    bspc {quit,wm -r}

# Close and Kill 
super + c
    bspc node -c

super + alt + c
    bspc node -k

# Alternate layouts
super + m
    bspc desktop -l next

# Node manipulation
super + y
    bspc node newest.marked.local -n newest.!automatic.local

super + g
    bspc node -s biggest.window

# --- Window States/Flags ---

# Set window state
super + {t,s,f}
    bspc node -t {tiled,floating,fullscreen}

# Set node flags
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

# --- Focus and Swapping ---

# Focus node in direction
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Swap node in direction
super + ctrl + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Focus node via path
super + {p,b,comma,period}
    bspc node -f @{parent,brother,first,second}

# Focus next/prev window
super + alt + {bracketright,bracketleft}
    bspc node -f {next,prev}.local.!hidden.window

# Focus last node/desktop
super + {grave,Tab}
    bspc {node,desktop} -f last

# Focus history
super + {o,i}
    bspc wm -h off; \
    bspc node {older,newer} -f; \
    bspc wm -h on

# --- Desktop Management ---

# Focus desktop 1-5
super + {1-5}
    bspc desktop -f '^{1-5}'

# Send node to desktop 1-5 
super + ctrl + {1-5}
    bspc node -d '^{1-5}'

# Focus next/previous desktop
super + {bracketright,bracketleft}
    bspc desktop -f {next,prev}.local

# --- Preselection ---

# Preselect direction
super + alt + {h,j,k,l}
    bspc node -p {west,south,north,east}

# Preselect ratio
super + alt + {1-9}
    bspc node -o 0.{1-9}

# Cancel preselection 
super + ctrl + space
    bspc node -p cancel

super + ctrl + alt + space
    bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

# --- Move/Resize ---

# Expand window (Outward)
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Contract window (Inward)
super + ctrl + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Move floating window
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}