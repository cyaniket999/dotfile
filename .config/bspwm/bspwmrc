#!/bin/sh

# Essential Background Daemons
pgrep -x sxhkd > /dev/null || sxhkd -m -1 &

# --- Security & Polkit ---
killall lxqt-policykit-agent polkit-gnome-authentication-agent-1 2>/dev/null
if [ -x /usr/lib/lxqt-policykit/lxqt-policykit-agent ]; then
    /usr/lib/lxqt-policykit/lxqt-policykit-agent &
elif [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

# --- Compositor, Notifications & Panel ---
killall picom 2>/dev/null; picom &
killall dunst 2>/dev/null; dunst &
killall tint2 2>/dev/null; tint2 &
killall xfdesktop 2>/dev/null; xfdesktop &

# --- Tray Applets ---
killall nm-applet 2>/dev/null; nm-applet &
killall blueman-applet 2>/dev/null; blueman-applet &
killall pasystray 2>/dev/null; pasystray &

# --- Monitor & Workspace Setup ---
bspc monitor -d 1 2 3 4 5

# --- Window Decorations (Aesthetic) ---
#bspc config focused_border_color "#05BFDB"
#bspc config normal_border_color "#282c34"
bspc config border_width 0
bspc config window_gap 2          

# This forces bspwm to tell the X server a window was "mapped" 
# every time you switch desktops, which kicks Picom into gear.
#bspc config focus_by_distance true

# --- Behavior ---
bspc config focus_follows_pointer true
bspc config pointer_follows_focus false
bspc config click_to_focus any
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
#bspc config transition_delay 0

# --- Mouse Bindings (Super/Mod4) ---
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side    # This is Middle Click
bspc config pointer_action3 resize_corner  # This is Right Click

# --- Window Rules ---

# 1. Global fallback size for any floating window that has no size defined
bspc config floating_rectangle 700x500+0+0

# 2. THE FIX: Force ALL windows to float, center, turn off maximize, AND set an explicit size
bspc rule -a "*" state=floating maximize=off rectangle=700x500+0+0

