configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: false;
}

@theme "/dev/null"

* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    accent: #89b4fa;

    border: 0px;
    border-radius: 0px;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 35%;
    border: 0px;
    border-radius: 0px;
    background-color: @bg;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border: 0px;
    border-radius: 0px;
    padding: 10px 14px;
    margin: 0 0 10px 0;
    children: [ entry ];
}

entry {
    placeholder: "Search applications...";
    placeholder-color: #6c7086;
    text-color: @fg;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    border: 0px;
    border-radius: 0px;
    spacing: 12px;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}